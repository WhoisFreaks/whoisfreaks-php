{
    "name": "whoisfreaks/whoisfreaks-php",
    "description": "PHP WHOIS API client: live, historical, reverse and bulk WHOIS, DNS lookup, domain availability, typosquatting",
    "keywords": [
        "whois",
        "whois-api",
        "whois-lookup",
        "rdap",
        "dns-lookup",
        "domain-availability",
        "typosquatting",
        "reverse-whois",
        "php"
    ],
    "homepage": "https://whoisfreaks.com/products/whois-api",
    "license": "MIT",
    "authors": [
        {
            "name": "WhoisFreaks",
            "email": "support@whoisfreaks.com",
            "homepage": "https://whoisfreaks.com"
        }
    ],
    "require": {
        "php": "^7.4 || ^8.0",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.3",
        "guzzlehttp/psr7": "^1.7 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.0 || ^9.0",
        "friendsofphp/php-cs-fixer": "^3.5"
    },
    "autoload": {
        "psr-4": {
            "WhoisFreaks\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WhoisFreaks\\Test\\": "test/"
        }
    },
    "support": {
        "issues": "https://github.com/WhoisFreaks/whoisfreaks-php/issues",
        "source": "https://github.com/WhoisFreaks/whoisfreaks-php",
        "docs": "https://whoisfreaks.com/documentation"
    }
}
